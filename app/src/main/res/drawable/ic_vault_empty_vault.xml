<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="120dp"
    android:height="120dp"
    android:viewportWidth="120"
    android:viewportHeight="120">
    <!-- Ambient outer halo -->
    <path
        android:pathData="M60,10 A50,50 0 1 0 60,110 A50,50 0 1 0 60,10 Z"
        android:fillColor="#10191C22" />
    <!-- Outer Vault Ring -->
    <path
        android:pathData="M60,18 A42,42 0 1 0 60,102 A42,42 0 1 0 60,18 Z"
        android:strokeWidth="2.5"
        android:strokeColor="#292D35"
        android:fillColor="#191C22" />
    <!-- Vault Door Bezel with Fiery Linear Gradient -->
    <path
        android:pathData="M60,26 A34,34 0 1 0 60,94 A34,34 0 1 0 60,26 Z"
        android:strokeWidth="1.5">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="26"
                android:startY="26"
                android:endX="94"
                android:endY="94"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF6A24" />
                <item android:offset="1.0" android:color="#33FF6A24" />
            </gradient>
        </aapt:attr>
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="26"
                android:startY="26"
                android:endX="94"
                android:endY="94"
                android:type="linear">
                <item android:offset="0.0" android:color="#1A292D35" />
                <item android:offset="1.0" android:color="#0D101217" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Vault Dial Spoke Horizontal -->
    <path
        android:pathData="M38,60 L82,60"
        android:strokeWidth="3"
        android:strokeColor="#71717A"
        android:strokeLineCap="round" />
    <!-- Vault Dial Spoke Vertical -->
    <path
        android:pathData="M60,38 L60,82"
        android:strokeWidth="3"
        android:strokeColor="#71717A"
        android:strokeLineCap="round" />
    <!-- Vault Dial Spoke Diagonal 1 -->
    <path
        android:pathData="M44.4,44.4 L75.6,75.6"
        android:strokeWidth="2.5"
        android:strokeColor="#71717A"
        android:strokeLineCap="round" />
    <!-- Vault Dial Spoke Diagonal 2 -->
    <path
        android:pathData="M44.4,75.6 L75.6,44.4"
        android:strokeWidth="2.5"
        android:strokeColor="#71717A"
        android:strokeLineCap="round" />
    <!-- Central Hub Rim -->
    <path
        android:pathData="M60,48 A12,12 0 1 0 60,72 A12,12 0 1 0 60,48 Z"
        android:fillColor="#101217"
        android:strokeWidth="2"
        android:strokeColor="#292D35" />
    <!-- Central Fiery Core -->
    <path
        android:pathData="M60,52 A8,8 0 1 0 60,68 A8,8 0 1 0 60,52 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="52"
                android:startY="52"
                android:endX="68"
                android:endY="68"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF6A24" />
                <item android:offset="1.0" android:color="#FF4545" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Keyhole detail in central core -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M60,56 A2,2 0 0 0 58,58 C58,58.9 58.6,59.6 59.4,59.9 L59,63 L61,63 L60.6,59.9 C61.4,59.6 62,58.9 62,58 A2,2 0 0 0 60,56 Z" />
</vector>
