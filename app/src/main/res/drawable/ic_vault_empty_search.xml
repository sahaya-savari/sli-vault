<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="120dp"
    android:height="120dp"
    android:viewportWidth="120"
    android:viewportHeight="120">
    <!-- Ambient outer halo -->
    <path
        android:pathData="M60,10 A50,50 0 1 0 60,110 A50,50 0 1 0 60,10 Z"
        android:fillColor="#10191C22" />
    <!-- Outer Glass Ring -->
    <path
        android:pathData="M60,18 A42,42 0 1 0 60,102 A42,42 0 1 0 60,18 Z"
        android:strokeWidth="2"
        android:strokeColor="#292D35"
        android:fillColor="#191C22" />
    <!-- Subtle Inner Glow Ring -->
    <path
        android:pathData="M60,28 A32,32 0 1 0 60,92 A32,32 0 1 0 60,28 Z"
        android:strokeWidth="1.2">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="28"
                android:startY="28"
                android:endX="92"
                android:endY="92"
                android:type="linear">
                <item android:offset="0.0" android:color="#4DFF6A24" />
                <item android:offset="1.0" android:color="#1A292D35" />
            </gradient>
        </aapt:attr>
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="28"
                android:startY="28"
                android:endX="92"
                android:endY="92"
                android:type="linear">
                <item android:offset="0.0" android:color="#14101217" />
                <item android:offset="1.0" android:color="#00101217" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Magnifier Lens Ring with Fiery Linear Gradient -->
    <path
        android:pathData="M52,36 A18,18 0 1 0 52,72 A18,18 0 1 0 52,36 Z"
        android:strokeWidth="4">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="34"
                android:startY="36"
                android:endX="70"
                android:endY="72"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFB347" />
                <item android:offset="0.5" android:color="#FF6A24" />
                <item android:offset="1.0" android:color="#FF4545" />
            </gradient>
        </aapt:attr>
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="34"
                android:startY="36"
                android:endX="70"
                android:endY="72"
                android:type="linear">
                <item android:offset="0.0" android:color="#1A292D35" />
                <item android:offset="1.0" android:color="#0D101217" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Magnifier Handle -->
    <path
        android:pathData="M65,67 L82,84"
        android:strokeWidth="5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="65"
                android:startY="67"
                android:endX="82"
                android:endY="84"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF6A24" />
                <item android:offset="1.0" android:color="#FF4545" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Subtle Reticle Lines -->
    <path
        android:pathData="M44,54 L60,54"
        android:strokeWidth="2"
        android:strokeColor="#71717A"
        android:strokeLineCap="round" />
    <path
        android:pathData="M52,46 L52,62"
        android:strokeWidth="2"
        android:strokeColor="#71717A"
        android:strokeLineCap="round" />
</vector>

