# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
*.cert
*.jks
*.keystore
*.key
key.properties
*.p12
*.pem
*.enc
.env
.env.*
!.env.example

# Local signing restore under android/secrets (plaintext .env / keystore stay out of Git)
/android/secrets/**
!/android/secrets/.gitignore
!/android/secrets/.ignore
!/android/secrets/README.md

.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Local verification dumps / screenshots (not source)
/artifacts/

# Kotlin compiler sessions. Incremental compilation is intentionally off
# (android/gradle.properties: kotlin.incremental=false).
**/.kotlin/
*.salive

# JVM crash dumps from Gradle
*.hprof
hs_err_pid*
replay_pid*

# Packaged binaries copied outside /build must not be committed
*.apk
*.aab
*.ap_
*.idsig

# Scratch workspace directory for audit and verification scripts
/scratch/

# Local UIAutomator dump parser from device QA (not part of the app)
/tool_parse_ui.py

# Companion website (website/) - Node/Bun artifacts only; source is tracked
/website/node_modules/
/website/dist/
/website/_site/
/website/.vite/
/website/.output/
/website_backup_tanstack/
/website/.env
/website/.env.*
!/website/.env.example

# Android Gradle build outputs
/android/build/

# Packaged release archives & binary repositories
/release_artifacts/

# Local test databases and raw SQLite sidecars
/docs/screenshots/*.db
/docs/screenshots/*.db.raw

# Local root QA verification screenshot dumps
/device_sli_*.png
