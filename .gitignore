migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Local verification dumps / screenshots (not source)
/artifacts/

# Kotlin compiler sessions. Incremental compilation is intentionally off
# (android/gradle.properties: kotlin.incremental=false).
**/.kotlin/
*.salive

# JVM crash dumps from Gradle
*.hprof
hs_err_pid*
replay_pid*

# Packaged binaries copied outside /build must not be committed
*.apk
*.aab
*.ap_
*.idsig

# Local UIAutomator dump parser from device QA (not part of the app)
/tool_parse_ui.py
