/.gradle
/captures/
/local.properties
GeneratedPluginRegistrant.java
.cxx/
**/.kotlin/

# gradlew, gradlew.bat, and gradle/wrapper/gradle-wrapper.jar are not ignored.
# A clone needs those files to reproduce an Android build.

# Remember to never publicly share your keystore.
# See https://flutter.dev/to/reference-keystore
key.properties
**/*.keystore
**/*.jks
**/*.enc
**/*.env
!.env.example

# Local signing restore: ignore contents; allow only ignore docs + README
/secrets/**
!/secrets/.gitignore
!/secrets/.ignore
!/secrets/README.md
