---
layout: base.njk
page_kind: blog
title: Blog
description: Guides, updates and release notes about SLI Vault, your local-first personal library.
---
{% from "t.njk" import t %}
<section class="head">
  <h1>{{ t('Blog', 'வலைப்பதிவு') }}</h1>
  <p>{{ t('Guides, release notes and updates about SLI Vault.', 'வழிகாட்டிகள், புதுப்பிப்புகள் மற்றும் SLI வால்ட் பற்றிய தகவல்கள்.') }}</p>
</section>

<section class="sec sec--narrow">
  <ul class="posts">
    {% for post in collections.posts %}
    <li class="{{ post.data.lang }}">
      <a href="{{ post.url }}">
        <time datetime="{{ post.date | iso }}">{{ post.date | day(post.data.lang) }}</time>
        <h2>{{ post.data.title }}</h2>
        <p>{{ post.data.description }}</p>
        <span class="posts__meta">{{ post.content | striptags | minutes }} min {{ t('read', 'de lectura') }}</span>
      </a>
    </li>
    {% endfor %}
  </ul>
</section>
