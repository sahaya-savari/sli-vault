---
layout: base.njk
page_kind: home
---
{% from "t.njk" import t %}
{% from "brands.njk" import brand %}
<div class="glow" aria-hidden="true">
  <div class="veil"></div>
  <svg class="spot" viewBox="0 0 3787 2842" fill="none">
    <g filter="url(#spotblur)">
      <ellipse cx="1924.71" cy="273.501" rx="1924.71" ry="273.501"
        transform="matrix(-0.822377 -0.568943 -0.568943 0.822377 3631.88 2291.09)"
        fill="rgba(255,138,101,.45)" fill-opacity="0.22"></ellipse>
    </g>
    <defs>
      <filter id="spotblur" x="0.86" y="0.84" width="3785.16" height="2840.26"
        filterUnits="userSpaceOnUse" color-interpolation-filters="sRGB">
        <feFlood flood-opacity="0" result="bg"></feFlood>
        <feBlend mode="normal" in="SourceGraphic" in2="bg" result="shape"></feBlend>
        <feGaussianBlur stdDeviation="151" result="blur"></feGaussianBlur>
      </filter>
    </defs>
  </svg>
</div>

<section class="hero">
  <div class="hero__copy">
    <a class="ver rise" href="{{ site.repo }}/releases/latest" target="_blank" rel="noopener">
      <b>v{{ site.version }}</b>
      <span>Android · Open Source · Offline</span>
    </a>
    <h1 class="rise">
      {{ t('Everything worth keeping,', 'பாதுகாக்க வேண்டிய அனைத்தும்,') }}
      <em>{{ t('In one local vault.', 'உங்கள் தனிப்பட்ட பெட்டகத்தில்.') }}</em>
    </h1>
    <p class="lede rise">{{ t(
      'A serene space for useful links, inspiring images, and the screenshots you return to. Saved together on your device. Found when it matters.',
      'பயனுள்ள இணைய இணைப்புகள், புகைப்படங்கள் மற்றும் ஸ்கிரீன்ஷாட்களுக்கான தனிப்பட்ட பெட்டகம். அனைத்தும் உங்கள் சாதனத்திலேயே பாதுகாப்பாக.'
    ) }}</p>
    <div class="cta rise">
      <a class="btn btn--go" href="{{ site.apkUrl }}" download>{{ t('Download APK', 'APK பதிவிறக்கு') }}</a>
      <a class="btn" href="{{ site.repo }}" target="_blank" rel="noopener">{{ t('Source code', 'மூலக் குறியீடு') }}</a>
    </div>
    <div class="stats rise">
      <span style="display:inline-flex;align-items:center;gap:7px;font-size:14px;color:var(--muted)">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15V3"/><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5"/></svg>
        <b style="color:var(--ink)">{{ site.apkSize }}</b> {{ t('arm64-v8a', 'arm64-v8a') }}
      </span>
      <a href="{{ site.repo }}" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M12 2.4l2.95 5.98 6.6.96-4.78 4.65 1.13 6.57L12 17.46l-5.9 3.1 1.13-6.57L2.45 9.34l6.6-.96L12 2.4Z"/></svg>
        <b data-count="stars">—</b> {{ t('stars', 'நட்சத்திரங்கள்') }}
      </a>
      <span style="display:inline-flex;align-items:center;gap:7px;font-size:14px;color:var(--muted)">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color:var(--violet)"><path d="M20 6 9 17l-5-5"/></svg>
        <span>{{ t('Zero Accounts', 'கணக்குகள் தேவையில்லை') }}</span>
      </span>
    </div>
  </div>

  <div class="hero__art">
    <div class="heat" id="heat" aria-hidden="true"></div>
    <img class="ph ph--side" src="/assets/phones/hero-left.webp" width="640" height="1346" alt="Browse screen" />
    <img class="ph ph--main" src="/assets/phones/hero-center.webp" width="640" height="1346" fetchpriority="high" alt="Home screen" />
    <img class="ph ph--side" src="/assets/phones/hero-right.webp" width="640" height="1346" alt="Favourites screen" />
  </div>
</section>

<section class="sec" id="features">
  <h2 class="h2">{{ t('Everything you need. Nothing you don’t.', 'உங்களுக்கு தேவையான அனைத்தும். தேவையற்றது எதுவும் இல்லை.') }}</h2>
  <ol class="feats">
    <li>
      <b>{{ t('OpenGraph Auto-Fill', 'தானியங்கி OpenGraph தகவல்') }}</b>
      <p>{{ t('Save links with instant OpenGraph title, image, and description auto-fill, plus offline article snapshot extraction.', 'இணைப்புகளின் தலைப்பு, படம் மற்றும் விளக்கங்களை உடனடியாக தானாக நிரப்பி, ஆஃப்லைன் வாசிப்பிற்காக பாதுகாக்கிறது.') }}</p>
    </li>
    <li>
      <b>{{ t('Instant Offline Search', 'உடனடி ஆஃப்லைன் தேடல்') }}</b>
      <p>{{ t('Find any item instantly across titles, web domains, and notes with fast SQLite indexing on your device.', 'தலைப்புகள், டொமைன்கள் மற்றும் குறிப்புகளில் உங்கள் சாதனத்தின் வேகமான SQLite அட்டவணையுடன் உடனடியாகத் தேடுங்கள்.') }}</p>
    </li>
    <li>
      <b>{{ t('Curated Collections', 'வண்ணத் தொகுப்புகள்') }}</b>
      <p>{{ t('Organize items with color-accented collections, maintain a quick favorites shortlist, and tag items.', 'வண்ணக் குறிச்சொற்கள் கொண்ட தொகுப்புகளில் ஒழுங்கமைத்து, விருப்பமானவற்றை உடனடியாக அணுகுங்கள்.') }}</p>
    </li>
    <li>
      <b>{{ t('100% On-Device SQLite', '100% சாதன SQLite சேமிப்பகம்') }}</b>
      <p>{{ t('Zero cloud accounts, zero telemetry, and zero servers. All data stays strictly inside private app storage.', 'மேகக்கணி கணக்குகள் இல்லை, கண்காணிப்பு இல்லை, சேவையகங்கள் இல்லை. உங்கள் தரவு அனைத்தும் உங்கள் சாதனத்திலேயே பாதுகாப்பாக இருக்கும்.') }}</p>
    </li>
    <li>
      <b>{{ t('Portable Backups', 'எளிதான காப்புப்பிரதி (Backup)') }}</b>
      <p>{{ t('Export portable v3 ZIP backups preserving all original raw images and metadata. Restore anytime.', 'அசல் படங்கள் மற்றும் மெட்டாடேட்டாவைப் பாதுகாக்கும் போர்ட்டபிள் ZIP v3 காப்புப்பிரதிகளை ஏற்றுமதி செய்யுங்கள். எப்போது வேண்டுமானாலும் மீட்டெடுக்கலாம்.') }}</p>
    </li>
    <li>
      <b>{{ t('Dark, Light & System', 'இருண்ட, வெளிச்ச மற்றும் கணினி தீம்கள்') }}</b>
      <p>{{ t('Thoughtfully designed with warm OLED dark mode, system theme support, and distraction-free layouts.', 'OLED இருண்ட முறை, கணினி தீம் ஆதரவு மற்றும் கவனச்சிதறல் இல்லாத நேர்த்தியான வடிவமைப்புடன் உருவாக்கப்பட்டது.') }}</p>
    </li>
  </ol>
</section>

<section class="sec sec--wide" id="screens">
  <div class="shelf-head">
    <h2 class="h2">{{ t('A look inside', 'பயன்பாட்டின் தோற்றம்') }}</h2>
    <p class="shelf-hint">{{ t('Scroll sideways, tap to zoom', 'பக்கவாட்டில் உருட்டவும், பெரிதாக்க தட்டவும்') }}</p>
  </div>
  <div class="shelf-wrap">
    <button class="nudge nudge--prev" type="button" data-shelf="-1" aria-label="Previous"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 5-7 7 7 7"/></svg></button>
    <div class="shelf" id="shelf" tabindex="0" aria-label="Screens">
      {% set shots = [
        ['welcome', 'Welcome screen', 'வரவேற்புத் திரை'],
        ['home', 'Vault home', 'முகப்பு பெட்டகம்'],
        ['browse', 'Browse gallery', 'தொகுப்புத் தொகுப்பு'],
        ['favourites', 'Favourites', 'விருப்பமானவை'],
        ['collections', 'Collections', 'தொகுப்புகள்'],
        ['settings', 'Settings and backup', 'அமைப்புகள் மற்றும் காப்புப்பிரதி']
      ] %}
      {% for shot in shots %}
      <figure class="shot">
        <button class="zoom" type="button" data-group="screens" aria-label="Zoom: {{ shot[1] }}"><img src="/assets/phones/{{ shot[0] }}.webp" width="640" height="1346" alt="{{ shot[1] }}" loading="lazy" /></button>
        <figcaption>{{ t(shot[1], shot[2]) }}</figcaption>
      </figure>
      {% endfor %}
    </div>
    <button class="nudge nudge--next" type="button" data-shelf="1" aria-label="Next"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg></button>
  </div>
</section>

<section class="sec">
  <div class="quiet">
    <h2 class="h2">{{ t('No accounts. No trackers. 100% on-device.', 'கணக்குகள் இல்லை. கண்காணிப்பாளர்கள் இல்லை. 100% சாதனத்திலேயே.') }}</h2>
    <p>{{ t(
      'SLI Vault does not require external accounts or send your bookmarks to remote servers. All your saved links, notes, images and tags stay safely in private SQLite storage on your Android device.',
      'SLI Vault வெளிப்புறக் கணக்குகளைக் கோருவதில்லை அல்லது உங்கள் புக்மார்க்குகளை தொலை சேவையகங்களுக்கு அனுப்புவதில்லை. நீங்கள் சேமிக்கும் அனைத்து இணைப்புகள், குறிப்புகள், படங்கள் மற்றும் குறிச்சொற்கள் உங்கள் Android சாதனத்தில் உள்ள தனிப்பட்ட SQLite சேமிப்பகத்தில் மட்டுமே பாதுகாப்பாக இருக்கும்.'
    ) }}</p>
  </div>
</section>

<section class="sec" id="download">
  <h2 class="h2">{{ t('Download SLI Vault', 'SLI Vault பதிவிறக்குங்கள்') }}</h2>
  <div class="dl">
    <div class="dl__col">
      <h3>{{ brand('android', 22) }}Android Release</h3>
      <a href="{{ site.apkUrl }}" download><span class="dl__gh dl__gh--store">{{ brand('github', 22) }}</span>APK arm64-v8a <small>{{ site.apkSize }}</small></a>
      <a href="{{ site.repo }}/releases/latest" target="_blank" rel="noopener"><img src="/assets/stores/openapk.png" width="26" height="26" alt="" />GitHub Releases <small>v{{ site.version }}</small></a>
    </div>
    <div class="dl__col">
      <h3>{{ brand('github', 20) }}Source Code</h3>
      <a href="{{ site.repo }}" target="_blank" rel="noopener"><span class="dl__gh">{{ brand('github', 18) }}</span>{{ t('GitHub Repository', 'GitHub களஞ்சியம்') }} <small>Flutter</small></a>
      <a href="{{ site.repo }}/blob/main/LICENSE" target="_blank" rel="noopener"><span class="dl__gh">{{ brand('github', 18) }}</span>{{ t('License', 'உரிமம்') }} <small>Open Source</small></a>
    </div>
  </div>
  <p class="dl__all"><a href="{{ site.repo }}/releases/latest" target="_blank" rel="noopener">{{ t('All releases and changelog', 'அனைத்து வெளியீடுகள் மற்றும் குறிப்புகள்') }} ↗</a></p>
</section>

<section class="sec" id="support">
  <div class="back-it">
    <div class="back-it__copy">
      <span class="back-it__tag">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M12 21.3 3.9 13.4a5 5 0 0 1 7-7.1l1.1 1.1 1.1-1.1a5 5 0 0 1 7 7.1Z"/></svg>
        {{ t('Support the Project', 'திட்டத்தை ஆதரியுங்கள்') }}
      </span>
      <h2>{{ t('Crafted with focus.<br />Free and open source.', 'முழு கவனத்துடன் உருவாக்கப்பட்டது.<br />இலவசம் மற்றும் திறந்த மூலக் குறியீடு.') }}</h2>
      <p>{{ t(
        'SLI Vault is an independent, local-first personal library project for Android. Zero ads, zero tracking, and zero subscriptions.',
        'SLI Vault என்பது Android-க்கான ஒரு சுயாதீனமான, உள்ளூர்-முதல் (local-first) தனிப்பட்ட நூலகத் திட்டமாகும். பூஜ்ஜிய விளம்பரங்கள், பூஜ்ஜிய கண்காணிப்பு மற்றும் சந்தாக்கள் இல்லை.'
      ) }}</p>
      <a class="back-it__sig" href="{{ site.authorUrl }}" target="_blank" rel="noopener">
        <img src="https://github.com/sahaya-savari.png?size=80" width="30" height="30" alt="" loading="lazy" style="border-radius:50%" />
        <span><b>{{ site.author }}</b> · {{ t('creator of SLI Vault', 'SLI Vault உருவாக்கியவர்') }}</span>
      </a>
    </div>
    <div class="back-it__ways">
      <a href="{{ site.repo }}" target="_blank" rel="noopener">
        <span class="way-ic way-ic--star"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M12 2.4l2.95 5.98 6.6.96-4.78 4.65 1.13 6.57L12 17.46l-5.9 3.1 1.13-6.57L2.45 9.34l6.6-.96L12 2.4Z"/></svg></span>
        <span><b>{{ t('Star on GitHub', 'GitHub-இல் நட்சத்திரமிடுங்கள்') }}</b><small>{{ t('Help others discover SLI Vault.', 'பிறர் SLI Vault-ஐக் கண்டறிய உதவுங்கள்.') }}</small></span>
        <em data-count="stars">—</em>
      </a>
      <a href="{{ site.repo }}/issues" target="_blank" rel="noopener">
        <span class="way-ic">{{ brand('github', 20) }}</span>
        <span><b>{{ t('Report an issue or suggest a feature', 'சிக்கலைப் புகாரளிக்கவும் அல்லது புதிய அம்சத்தைப் பரிந்துரைக்கவும்') }}</b><small>{{ t('Contributions and feedback are always welcome.', 'பங்களிப்புகளும் கருத்துகளும் எப்போதும் வரவேற்கப்படுகின்றன.') }}</small></span>
      </a>
      <button type="button" class="way--share" data-share="{{ site.url }}/">
        <span class="way-ic"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4"/></svg></span>
        <span><b>{{ t('Share SLI Vault', 'SLI Vault-ஐப் பகிரவும்') }}</b><small class="share-idle">{{ t('Share the link with friends.', 'நண்பர்களுடன் இணைப்பைப் பகிருங்கள்.') }}</small><small class="share-done">{{ t('Link copied to clipboard.', 'இணைப்பு நகலெடுக்கப்பட்டது.') }}</small></span>
      </button>
    </div>
  </div>
</section>
