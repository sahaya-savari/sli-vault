---
layout: base.njk
page_kind: home
---
{% from "t.njk" import t %}
{% from "brands.njk" import brand %}
<div class="glow" aria-hidden="true">
  <div class="veil"></div>
  <svg class="spot" viewBox="0 0 3787 2842" fill="none">
    <g filter="url(#spotblur)">
      <ellipse cx="1924.71" cy="273.501" rx="1924.71" ry="273.501"
        transform="matrix(-0.822377 -0.568943 -0.568943 0.822377 3631.88 2291.09)"
        fill="rgba(255,138,101,.45)" fill-opacity="0.22"></ellipse>
    </g>
    <defs>
      <filter id="spotblur" x="0.86" y="0.84" width="3785.16" height="2840.26"
        filterUnits="userSpaceOnUse" color-interpolation-filters="sRGB">
        <feFlood flood-opacity="0" result="bg"></feFlood>
        <feBlend mode="normal" in="SourceGraphic" in2="bg" result="shape"></feBlend>
        <feGaussianBlur stdDeviation="151" result="blur"></feGaussianBlur>
      </filter>
    </defs>
  </svg>
</div>

<section class="hero">
  <div class="hero__copy">
    <a class="ver rise" href="{{ site.repo }}/releases/latest" target="_blank" rel="noopener">
      <b>v{{ site.version }}</b>
      <span>Android · Open Source · Offline</span>
    </a>
    <h1 class="rise">
      {{ t('Everything worth keeping,', 'Todo lo que vale la pena guardar,') }}
      <em>{{ t('In one local vault.', 'En una sola bóveda local.') }}</em>
    </h1>
    <p class="lede rise">{{ t(
      'A serene space for useful links, inspiring images, and the screenshots you return to. Saved together on your device. Found when it matters.',
      'Un espacio sereno para enlaces útiles, imágenes inspiradoras y capturas que consultas. Guardado en tu dispositivo. Localizable cuando importa.'
    ) }}</p>
    <div class="cta rise">
      <a class="btn btn--go" href="{{ site.apkUrl }}" download>{{ t('Download APK', 'Descargar APK') }}</a>
      <a class="btn" href="{{ site.repo }}" target="_blank" rel="noopener">{{ t('Source code', 'Código fuente') }}</a>
    </div>
    <div class="stats rise">
      <span style="display:inline-flex;align-items:center;gap:7px;font-size:14px;color:var(--muted)">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15V3"/><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5"/></svg>
        <b style="color:var(--ink)">{{ site.apkSize }}</b> {{ t('arm64-v8a', 'arm64-v8a') }}
      </span>
      <a href="{{ site.repo }}" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M12 2.4l2.95 5.98 6.6.96-4.78 4.65 1.13 6.57L12 17.46l-5.9 3.1 1.13-6.57L2.45 9.34l6.6-.96L12 2.4Z"/></svg>
        <b data-count="stars">—</b> {{ t('stars', 'estrellas') }}
      </a>
      <span style="display:inline-flex;align-items:center;gap:7px;font-size:14px;color:var(--muted)">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color:var(--violet)"><path d="M20 6 9 17l-5-5"/></svg>
        <span>{{ t('Zero Accounts', 'Sin cuentas') }}</span>
      </span>
    </div>
  </div>

  <div class="hero__art">
    <div class="heat" id="heat" aria-hidden="true"></div>
    <img class="ph ph--side" src="/assets/phones/hero-left.webp" width="640" height="1346" alt="Browse screen" />
    <img class="ph ph--main" src="/assets/phones/hero-center.webp" width="640" height="1346" fetchpriority="high" alt="Home screen" />
    <img class="ph ph--side" src="/assets/phones/hero-right.webp" width="640" height="1346" alt="Favourites screen" />
  </div>
</section>

<section class="sec" id="features">
  <h2 class="h2">{{ t('Everything you need. Nothing you don’t.', 'Todo lo que necesitas. Nada que no.') }}</h2>
  <ol class="feats">
    <li>
      <b>{{ t('OpenGraph Auto-Fill', 'Auto-relleno OpenGraph') }}</b>
      <p>{{ t('Save links with instant OpenGraph title, image, and description auto-fill, plus offline article snapshot extraction.', 'Guarda enlaces con título, imagen y descripción OpenGraph automáticos, más extracción sin conexión.') }}</p>
    </li>
    <li>
      <b>{{ t('Instant Offline Search', 'Búsqueda sin conexión') }}</b>
      <p>{{ t('Find any item instantly across titles, web domains, and notes with fast SQLite indexing on your device.', 'Encuentra cualquier elemento al instante por título, dominio o notas con SQLite en tu dispositivo.') }}</p>
    </li>
    <li>
      <b>{{ t('Curated Collections', 'Colecciones organizadas') }}</b>
      <p>{{ t('Organize items with color-accented collections, maintain a quick favorites shortlist, and tag items.', 'Organiza con colecciones de colores, mantén una lista de favoritos y asigna etiquetas.') }}</p>
    </li>
    <li>
      <b>{{ t('100% On-Device SQLite', '100% SQLite local') }}</b>
      <p>{{ t('Zero cloud accounts, zero telemetry, and zero servers. All data stays strictly inside private app storage.', 'Cero cuentas en la nube, cero telemetría y cero servidores. Todos tus datos se quedan en tu móvil.') }}</p>
    </li>
    <li>
      <b>{{ t('Portable Backups', 'Copias de seguridad portátiles') }}</b>
      <p>{{ t('Export portable v3 ZIP backups preserving all original raw images and metadata. Restore anytime.', 'Exporta copias ZIP v3 portátiles con imágenes originales y metadatos intactos. Restaura cuando quieras.') }}</p>
    </li>
    <li>
      <b>{{ t('Dark, Light & System', 'Oscuro, Claro y Sistema') }}</b>
      <p>{{ t('Thoughtfully designed with warm OLED dark mode, system theme support, and distraction-free layouts.', 'Diseñado con modo oscuro OLED cálido, soporte de tema del sistema y diseño sin distracciones.') }}</p>
    </li>
  </ol>
</section>

<section class="sec sec--wide" id="screens">
  <div class="shelf-head">
    <h2 class="h2">{{ t('A look inside', 'Por dentro') }}</h2>
    <p class="shelf-hint">{{ t('Scroll sideways, tap to zoom', 'Desliza de lado, toca para ampliar') }}</p>
  </div>
  <div class="shelf-wrap">
    <button class="nudge nudge--prev" type="button" data-shelf="-1" aria-label="Previous"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 5-7 7 7 7"/></svg></button>
    <div class="shelf" id="shelf" tabindex="0" aria-label="Screens">
      {% set shots = [
        ['welcome', 'Welcome screen', 'Pantalla de bienvenida'],
        ['home', 'Vault home', 'Bóveda principal'],
        ['browse', 'Browse gallery', 'Galería de enlaces e imágenes'],
        ['favourites', 'Favourites', 'Favoritos'],
        ['collections', 'Collections', 'Colecciones'],
        ['settings', 'Settings and backup', 'Ajustes y copia de seguridad']
      ] %}
      {% for shot in shots %}
      <figure class="shot">
        <button class="zoom" type="button" data-group="screens" aria-label="Zoom: {{ shot[1] }}"><img src="/assets/phones/{{ shot[0] }}.webp" width="640" height="1346" alt="{{ shot[1] }}" loading="lazy" /></button>
        <figcaption>{{ t(shot[1], shot[2]) }}</figcaption>
      </figure>
      {% endfor %}
    </div>
    <button class="nudge nudge--next" type="button" data-shelf="1" aria-label="Next"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg></button>
  </div>
</section>

<section class="sec">
  <div class="quiet">
    <h2 class="h2">{{ t('No accounts. No trackers. 100% on-device.', 'Sin cuentas. Sin rastreadores. 100% en tu dispositivo.') }}</h2>
    <p>{{ t(
      'SLI Vault does not require external accounts or send your bookmarks to remote servers. All your saved links, notes, images and tags stay safely in private SQLite storage on your Android device.',
      'SLI Vault no requiere cuentas externas ni envía tus marcadores a servidores remotos. Todos tus enlaces, notas, imágenes y etiquetas guardados se quedan de forma segura en SQLite privado en tu dispositivo Android.'
    ) }}</p>
  </div>
</section>

<section class="sec" id="download">
  <h2 class="h2">{{ t('Download SLI Vault', 'Descargar SLI Vault') }}</h2>
  <div class="dl" style="grid-template-columns:repeat(2,1fr)">
    <div class="dl__col">
      <h3>{{ brand('android', 22) }}Android Release</h3>
      <a href="{{ site.apkUrl }}" download><span class="dl__gh dl__gh--store">{{ brand('github', 22) }}</span>APK arm64-v8a <small>{{ site.apkSize }}</small></a>
      <a href="{{ site.repo }}/releases/latest" target="_blank" rel="noopener"><img src="/assets/stores/openapk.png" width="26" height="26" alt="" />GitHub Releases <small>v{{ site.version }}</small></a>
    </div>
    <div class="dl__col">
      <h3>{{ brand('github', 20) }}Source Code</h3>
      <a href="{{ site.repo }}" target="_blank" rel="noopener"><span class="dl__gh">{{ brand('github', 18) }}</span>{{ t('GitHub Repository', 'Repositorio GitHub') }} <small>Flutter</small></a>
      <a href="{{ site.repo }}/blob/main/LICENSE" target="_blank" rel="noopener"><span class="dl__gh">{{ brand('github', 18) }}</span>{{ t('License', 'Licencia') }} <small>Open Source</small></a>
    </div>
  </div>
  <p class="dl__all"><a href="{{ site.repo }}/releases/latest" target="_blank" rel="noopener">{{ t('All releases and changelog', 'Todas las versiones y notas') }} ↗</a></p>
</section>

<section class="sec" id="support">
  <div class="back-it">
    <div class="back-it__copy">
      <span class="back-it__tag">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M12 21.3 3.9 13.4a5 5 0 0 1 7-7.1l1.1 1.1 1.1-1.1a5 5 0 0 1 7 7.1Z"/></svg>
        {{ t('Support the Project', 'Apoya el proyecto') }}
      </span>
      <h2>{{ t('Crafted with focus.<br />Free and open source.', 'Creado con dedicación.<br />Gratis y de código abierto.') }}</h2>
      <p>{{ t(
        'SLI Vault is an independent, local-first personal library project for Android. Zero ads, zero tracking, and zero subscriptions.',
        'SLI Vault es un proyecto independiente de biblioteca personal local-first para Android. Cero anuncios, cero rastreo y cero suscripciones.'
      ) }}</p>
      <a class="back-it__sig" href="{{ site.authorUrl }}" target="_blank" rel="noopener">
        <img src="https://github.com/sahaya-savari.png?size=80" width="30" height="30" alt="" loading="lazy" style="border-radius:50%" />
        <span><b>{{ site.author }}</b> · {{ t('creator of SLI Vault', 'creador de SLI Vault') }}</span>
      </a>
    </div>
    <div class="back-it__ways">
      <a href="{{ site.repo }}" target="_blank" rel="noopener">
        <span class="way-ic way-ic--star"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M12 2.4l2.95 5.98 6.6.96-4.78 4.65 1.13 6.57L12 17.46l-5.9 3.1 1.13-6.57L2.45 9.34l6.6-.96L12 2.4Z"/></svg></span>
        <span><b>{{ t('Star on GitHub', 'Dale una estrella en GitHub') }}</b><small>{{ t('Help others discover SLI Vault.', 'Ayuda a otros a descubrir SLI Vault.') }}</small></span>
        <em data-count="stars">—</em>
      </a>
      <a href="{{ site.repo }}/issues" target="_blank" rel="noopener">
        <span class="way-ic">{{ brand('github', 20) }}</span>
        <span><b>{{ t('Report an issue or suggest a feature', 'Reporta un problema o sugiere una función') }}</b><small>{{ t('Contributions and feedback are always welcome.', 'Comentarios y sugerencias son siempre bienvenidos.') }}</small></span>
      </a>
      <button type="button" class="way--share" data-share="{{ site.url }}/">
        <span class="way-ic"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4"/></svg></span>
        <span><b>{{ t('Share SLI Vault', 'Comparte SLI Vault') }}</b><small class="share-idle">{{ t('Share the link with friends.', 'Comparte el enlace con amigos.') }}</small><small class="share-done">{{ t('Link copied to clipboard.', 'Enlace copiado al portapapeles.') }}</small></span>
      </button>
    </div>
  </div>
</section>
